# phantom-server config (consumed by compose.yml on first boot)
#
# Required on FIRST boot only. Once /config/server.toml exists, env-vars are ignored.

# TLS server name / SNI. Должен совпадать с тем что клиенты увидят в ghs:// ссылке.
# Пример: nl2.bikini-bottom.com
# На хосте должен лежать LE-серт /etc/letsencrypt/live/$SERVER_NAME/ — без него
# bootstrap падает (клиенты не примут самоподписанный).
SERVER_NAME=

# Image source (для pull из ghcr.io, пакеты приватные: docker login ghcr.io).
# Меняй на свой ник если форкаешь. TAG — конкретная версия, не latest.
GHCR_OWNER=patrickredstar
TAG=0.28.5

# WAN-интерфейс хоста — куда MASQUERADE'нуть исходящий трафик.
# Проверь: `ip route show default | awk '{print $5}'`
WAN_IFACE=eth0

# Опционально — переопределить дефолты:
# TUN_NAME=tun1
# TUN_ADDR=10.7.0.1/24
# LISTEN_ADDR=0.0.0.0:443

# Публичный IP сервера. Используется для генерации ghs:// connect-host'ов клиентам.
# Если оставить пустым — entrypoint попытается определить через https://ifconfig.me.
# Если оба не сработали (нет интернета на bootstrap'е) — keys.py будет спрашивать
# интерактивно при каждом вызове. Лучше задать явно.
PUBLIC_IP=

# Admin API token. Оставь пустым — entrypoint сгенерит и запишет в
# ./config/server.toml ([admin].token, права 0600), в лог не печатает.
ADMIN_TOKEN=
