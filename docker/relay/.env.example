# phantom-relay config (first boot only)

# Пакеты ghcr.io приватные — сначала docker login ghcr.io. TAG — конкретная версия.
GHCR_OWNER=patrickredstar
TAG=0.28.5

# Адрес NL exit (phantom-server). Включая порт — :8443, а не :443
# (из РФ :443 exit'а фильтруется).
# Пример: 89.110.109.128:8443
UPSTREAM_ADDR=

# SNI, который реальные клиенты шлют в ClientHello — имя exit'а, не реле.
# Должен совпадать с SERVER_NAME сервера (cert у клиента подписан CN=$EXPECTED_SNI),
# иначе все клиенты падают с BadCertificate.
# Пример: tls.nl2.bikini-bottom.com
EXPECTED_SNI=

# LE cert собственного имени реле — его видит проб с чужим SNI.
# Обязателен: без него чужой SNI получает мгновенный обрыв, что похоже на блок.
# Продление подхватывается без рестарта.
FALLBACK_CERT=/config/fullchain.pem
FALLBACK_KEY=/config/privkey.pem

# Опционально:
# LISTEN_ADDR=0.0.0.0:5443
