    "welcome.install.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the VPN extension"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите VPN-расширение"
          }
        }
      }
