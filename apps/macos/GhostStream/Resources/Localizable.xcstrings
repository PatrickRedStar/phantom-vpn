    "welcome.install.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GhostStream encrypts traffic through a macOS system extension. You allow it once — after that it just works."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GhostStream шифрует трафик через системное расширение macOS. Его разрешают один раз — дальше всё работает само."
          }
        }
      }
    },
    "welcome.install.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Install — macOS will show a prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Установить» — macOS покажет запрос."
          }
        }
      }
    },
    "welcome.install.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → General → Login Items & Extensions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Системные настройки → Основные → Объекты входа и расширения»."
          }
        }
      }
    },
    "welcome.install.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Network Extensions, turn on GhostStream and click Allow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Сетевые расширения» включите GhostStream и нажмите «Разрешить»."
          }
        }
      }
    },
    "welcome.install.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить"
          }
        }
      }
    },
    "welcome.approve.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём разрешения"
          }
        }
      }
    },
    "welcome.approve.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → General → Login Items & Extensions, find GhostStream under Network Extensions and click Allow. Setup will continue on its own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Системные настройки → Основные → Объекты входа и расширения», найдите GhostStream в разделе «Сетевые расширения» и нажмите «Разрешить». Дальше мастер продолжит сам."
          }
        }
      }
    },
    "welcome.approve.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent — waiting for macOS…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отправлен — ждём ответа macOS…"
          }
        }
      }
    },
    "welcome.approve.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you to click Allow"
          }
        },
        "ru": {
