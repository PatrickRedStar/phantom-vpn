    "welcome.reboot.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will finish installing the extension after a restart. Then open GhostStream — setup will continue from this step."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS закончит установку расширения после перезагрузки. Потом откройте GhostStream — мастер продолжит с этого шага."
          }
        }
      }
    },
    "welcome.configure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the VPN configuration"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте конфигурацию VPN"
          }
        }
      }
