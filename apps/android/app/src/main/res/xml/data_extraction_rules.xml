<?xml version="1.0" encoding="utf-8"?>
<!-- Client keys, settings and the journal never leave the device. On Android 12+
     allowBackup="false" stops cloud backup but not device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="profiles.json" />
        <exclude domain="file" path="profiles/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="profiles.json" />
        <exclude domain="file" path="profiles/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
